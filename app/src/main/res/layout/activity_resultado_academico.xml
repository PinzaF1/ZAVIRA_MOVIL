<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F5F7FF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="24dp">

        <!-- Header: título centrado -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:layout_marginTop="34dp"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Resultados del Diagnóstico Inicial"
                android:textStyle="bold"
                android:textColor="#1759F2"
                android:textSize="20sp"/>

            <View
                android:layout_width="42dp"
                android:layout_height="3dp"
                android:layout_marginTop="6dp"
                android:background="#251DEF"
                android:alpha="0.9"/>
        </LinearLayout>

        <!-- TARJETA: Puntaje General (DISEÑO MEJORADO) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="@android:color/white"
            app:cardCornerRadius="18dp"
            app:strokeColor="#E6EAF2"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Nuevo diseño: fila con anillo y métricas -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <!-- Anillo circular con porcentaje en el centro -->
                    <FrameLayout
                        android:layout_width="120dp"
                        android:layout_height="120dp"
                        android:layout_marginEnd="16dp"
                        android:contentDescription="Indicador de puntaje">

                        <com.google.android.material.progressindicator.CircularProgressIndicator
                            android:id="@+id/progresoPuntaje"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:indeterminate="false"
                            app:indicatorSize="120dp"
                            app:trackThickness="12dp"
                            app:indicatorInset="0dp"
                            app:indicatorDirectionCircular="clockwise"
                            app:indicatorColor="@color/progress_primary"
                            app:trackColor="@color/progress_track" />

                        <TextView
                            android:id="@+id/tvPuntajeGeneral"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:text="—"
                            android:textStyle="bold"
                            android:textSize="20sp"
                            android:textColor="@color/text_primary"
                            android:contentDescription="Porcentaje de puntaje"/>
                    </FrameLayout>

                    <!-- Métricas a la derecha -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Puntaje (ICFES)"
                            android:textColor="#555D6D"
                            android:textSize="12sp"/>

                        <TextView
                            android:id="@+id/tvPuntajeGeneralIcfes"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="—"
                            android:textColor="#403E9A"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="8dp"/>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="4dp"
                            android:gravity="center_vertical">

                            <TextView
                                android:id="@+id/tvTotalCorrectas"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="— correctas"
                                android:textColor="@color/text_primary"
                                android:textSize="14sp"
                                android:textStyle="bold"/>

                            <TextView
                                android:id="@+id/tvTotalIncorrectas"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:text="— incorrectas"
                                android:textColor="@color/rojo_necesita"
                                android:textSize="14sp"
                                android:textStyle="bold"/>
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvTotalPreguntas"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="— preguntas totales"
                            android:textColor="#555D6D"
                            android:textSize="12sp"/>

                    </LinearLayout>
                </LinearLayout>

                <!-- Donde se listarán puntajes por área (sin cambios, se llena desde Activity) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="12dp"/>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- TARJETA: Puntajes por Área -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="@android:color/white"
            app:cardCornerRadius="18dp"
            app:strokeColor="#E6EAF2"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="#FFE8D1"
                        android:gravity="center"
                        android:text="📚"
                        android:textSize="14sp"
                        android:padding="2dp"
                        android:includeFontPadding="false"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="Puntajes por Área"
                        android:textStyle="bold"
                        android:textColor="#171A1F"
                        android:textSize="15sp"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/containerPuntajesPorArea"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="12dp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Botón -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnIrHome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ir al inicio"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:padding="14dp"
            app:cornerRadius="26dp"
            app:backgroundTint="@color/primaryyy"/>
    </LinearLayout>
</ScrollView>
